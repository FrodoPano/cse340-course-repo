<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

    <p><a href="/new-project">Add a New Service Project</a></p>

    <% if (typeof projects !== 'undefined' && projects.length > 0) { %>
        <ul class="projects-list">
            <% projects.forEach(project => { %>
                <li>
                    <a href="/project/<%= project.project_id %>">
                        <strong><%= project.formatted_date %>: <%= project.title %></strong>
                    </a>
                    (<a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>)
                    <p><%= project.description %></p>
                    <p><small>Location: <%= project.location %></small></p>
                </li>
            <% }); %>
        </ul>
    <% } else { %>
        <p>No upcoming service projects found. Please check back soon!</p>
    <% } %>
</main>

<%- include('partials/footer') %>