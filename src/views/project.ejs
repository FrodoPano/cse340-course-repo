<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

    <h2><%= projectDetails.title %></h2>

    <p><a href="/edit-project/<%= projectDetails.project_id %>">Edit Project</a></p>

    <p><strong>Date:</strong> <%= projectDetails.formatted_date %></p>
    <p><strong>Location:</strong> <%= projectDetails.location %></p>
    <p><strong>Description:</strong> <%= projectDetails.description %></p>

    <p>
        <strong>Organization:</strong> 
        <a href="/organization/<%= projectDetails.organization_id %>"><%= projectDetails.organization_name %></a>
    </p>

    <h3>Categories</h3>
    <% if (typeof categories !== 'undefined' && categories.length > 0) { %>
        <ul class="category-tags">
            <% categories.forEach(category => { %>
                <li>
                    <a href="/category/<%= category.category_id %>" class="category-tag"><%= category.name %></a>
                </li>
            <% }); %>
        </ul>
    <% } else { %>
        <p>No categories assigned to this project.</p>
    <% } %>

    <p><a href="/assign-categories/<%= projectDetails.project_id %>">Edit Categories</a></p>

    <p><a href="/projects">← Back to Upcoming Projects</a></p>
</main>
<%- include('partials/footer') %>